{
  "manifest_version": 3,
  "name": "AW_hotPin",
  "version": "1.1",
  "description": "Закрепление/открепление вкладки горячей клавишей",
  "author": "AW",
  
  "permissions": [
    "tabs",
    "storage"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  
  "commands": {
    "toggle-pin": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Закрепить/открепить текущую вкладку"
    }
  },
  
  "icons": {
    "128": "icon128.png"
  }
}