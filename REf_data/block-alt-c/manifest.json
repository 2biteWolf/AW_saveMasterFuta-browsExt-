{
  "manifest_version": 3,
  "name": "Block Alt",
  "version": "1.1",
  "description": "Blocks Opera's Alt key (menu/context). Toggle via popup.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle Alt block"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
